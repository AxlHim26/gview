# Tailscale Configuration Template
# Copy this file to .env: cp env.example .env
# Then edit .env with your actual values

# Tailscale auth key (90-day reusable)
# Get from: https://login.tailscale.com -> Settings -> Keys
export AUTH_KEY=example

# Server Tailscale IP address  
# Run 'tailscale ip -4' on server after it joins tailnet
export SERVER_TS_ADDR=example

