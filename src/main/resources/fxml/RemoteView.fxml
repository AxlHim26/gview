<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.p2pclient.ui.fx.RemoteViewController" styleClass="surface">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
            <padding>
                <Insets topRightBottomLeft="10" />
            </padding>
            <Label text="Remote View" styleClass="section-title" />
            <Label fx:id="metricsLabel" text="fps: - | rtt: - | cpu: -" styleClass="muted" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Disconnect" onAction="#handleDisconnect" />
            <Button fx:id="fullScreenButton" text="Fullscreen" onAction="#toggleFullScreen" />
            <Label fx:id="roleLabel" text="Role: idle" />
        </HBox>
    </top>
    <center>
        <HBox styleClass="remote-view-center" spacing="10" maxWidth="Infinity" maxHeight="Infinity">
            <StackPane fx:id="remoteSurface" styleClass="remote-surface" HBox.hgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                <Canvas fx:id="remoteCanvas" />
                <Label fx:id="overlayLabel" text="Waiting for session" styleClass="overlay" />
            </StackPane>
            <VBox fx:id="chatContainer" spacing="8" styleClass="panel-border" prefWidth="360" maxWidth="360" minWidth="360">
                <Label text="Chat" styleClass="section-title" />
                <TextArea fx:id="chatArea" prefRowCount="7" wrapText="true" editable="false" VBox.vgrow="ALWAYS" />
                <HBox spacing="8">
                    <TextField fx:id="chatInput" promptText="Type a message..." HBox.hgrow="ALWAYS" />
                    <Button text="Send" onAction="#sendChat" />
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
